* text=auto eol=lf

# cmd.exe reads batch files most reliably with CRLF line endings.
*.cmd text eol=crlf

*.png binary
*.jpg binary
*.gif binary
*.webp binary
*.ico binary
*.woff2 binary

# Third-party files are stored byte for byte; their hashes are recorded in VENDOR.md.
beyin_web/static/vendor/** -text
